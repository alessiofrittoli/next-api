{
	"name": "@alessiofrittoli/next-api",
	"version": "0.13.0",
	"description": "Next.js API utility library",
	"type": "module",
	"author": {
		"name": "Alessio Frittoli",
		"email": "info@alessiofrittoli.it",
		"url": "https://alessiofrittoli.it"
	},
	"license": "MIT",
	"funding": [
		{
			"type": "github",
			"url": "https://github.com/sponsors/alessiofrittoli"
		}
	],
	"keywords": [
		"next",
		"next.js",
		"next-server"
	],
	"homepage": "https://github.com/alessiofrittoli/next-api#readme",
	"bugs": {
		"url": "https://github.com/alessiofrittoli/next-api/issues",
		"email": "info@alessiofrittoli.it"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alessiofrittoli/next-api.git"
	},
	"engines": {
		"node": ">=24.15.0",
		"pnpm": ">=11.27.1"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"scripts/postinstall"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./*": {
			"import": {
				"types": "./dist/*/index.d.mts",
				"default": "./dist/*/index.mjs"
			},
			"require": {
				"types": "./dist/*/index.d.cts",
				"default": "./dist/*/index.cjs"
			}
		}
	},
	"sideEffects": false,
	"scripts": {
		"//1a": "*********************************************************************",
		"//1b": "******************** DEV - BUILD - LINT - RELEASE *******************",
		"//1c": "*********************************************************************",
		"dev": "tsdown --watch",
		"build": "pnpm lint && pnpm tsc && pnpm tsdown",
		"lint": "eslint --report-unused-disable-directives --max-warnings 0",
		"release": "node scripts/release.ts --verbose --npm",
		"//2a": "*********************************************************************",
		"//2b": "***************************** UNIT TESTS ****************************",
		"//2c": "*********************************************************************",
		"test": "vitest --reporter=tree",
		"test:watch": "pnpm test watch",
		"test:ci": "pnpm test run",
		"//3a": "*********************************************************************",
		"//3b": "************************ UNIT TESTS COVERAGE ************************",
		"//3c": "*********************************************************************",
		"test:coverage": "pnpm test:watch --coverage",
		"test:coverage:ci": "pnpm test:ci --coverage",
		"test:serve-coverage": "http-server ./coverage --gzip true -p 0 -o /index.html --silent",
		"test:coverage:serve": "concurrently --prefix none --kill-others \"pnpm test:coverage\" \"pnpm test:serve-coverage\"",
		"//4a": "*********************************************************************",
		"//4b": "******************************* OTHER *******************************",
		"//4c": "*********************************************************************",
		"postinstall": "node scripts/postinstall/index.cjs"
	},
	"peerDependencies": {
		"@alessiofrittoli/chain-functions": "^2.8.0",
		"@alessiofrittoli/date-utils": "^4.3.0",
		"@alessiofrittoli/exception": "^4.2.0",
		"@alessiofrittoli/node-scripts": "^4.2.0",
		"@alessiofrittoli/stream-reader": "^3.3.0",
		"@alessiofrittoli/typed-map": "^1.1.0",
		"@alessiofrittoli/url-utils": "^4.2.0",
		"@alessiofrittoli/web-utils": "^3.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"next": "^16.4.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"peerDependenciesMeta": {
		"@alessiofrittoli/date-utils": {
			"optional": true
		},
		"@alessiofrittoli/exception": {
			"optional": true
		},
		"@alessiofrittoli/stream-reader": {
			"optional": true
		},
		"@alessiofrittoli/typed-map": {
			"optional": true
		},
		"@alessiofrittoli/url-utils": {
			"optional": true
		},
		"@alessiofrittoli/web-utils": {
			"optional": true
		}
	},
	"devDependencies": {
		"@alessiofrittoli/chain-functions": "^2.8.0",
		"@alessiofrittoli/date-utils": "^4.3.0",
		"@alessiofrittoli/exception": "^4.2.0",
		"@alessiofrittoli/node-scripts": "^4.2.0",
		"@alessiofrittoli/package-configs": "^1.11.0",
		"@alessiofrittoli/stream-reader": "^3.3.0",
		"@alessiofrittoli/type-utils": "^2.1.0",
		"@alessiofrittoli/typed-map": "^1.1.0",
		"@alessiofrittoli/url-utils": "^4.2.0",
		"@alessiofrittoli/web-utils": "^3.0.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/browser-playwright": "^5.0.5",
		"@vitest/coverage-v8": "^5.0.5",
		"concurrently": "^10.0.6",
		"eslint": "^10.13.0",
		"eslint-config-next": "16.4.3",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-server-components": "^1.2.0",
		"globals": "^17.13.0",
		"http-server": "^14.1.1",
		"next": "^16.4.3",
		"prettier": "^3.9.10",
		"prettier-plugin-sort-imports": "^1.8.11",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwindcss": "^4",
		"tsdown": "^0.23.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vitest": "^5.0.5"
	}
}
